# BORA Environment Variables

# LLM Provider
# Required: Your Groq API key for the llama-3.3-70b-versatile model
GROQ_API_KEY=your_groq_api_key_here

# Stripe Integration
# Required: Your Stripe secret API key (starts with sk_test_ or sk_live_)
STRIPE_API_KEY=your_stripe_api_key_here
# Required: Your Stripe webhook secret to verify payment events (starts with whsec_)
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Resend Email Delivery
# Required: Your Resend API key for delivering PDF reports
RESEND_API_KEY=re_4ghmnHpU_KgRJzDMnKkT5EbB9v8TetiQ6
# Required: The verified sender email address in Resend
RESEND_FROM_EMAIL=BORA Reports <reports@yourdomain.com>

# App URL
# Required: The base URL where BORA is hosted (e.g., https://bora.streamlit.app)
# This is needed for Stripe checkout success/cancel redirects
DOMAIN_URL=http://localhost:8501
